{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Edufy Finance default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "notification:default"
  ]
}
