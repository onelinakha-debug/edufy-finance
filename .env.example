# Copy to .env and fill in. Never commit real secrets.
# ── Server ──
HOST=0.0.0.0
PORT=8080
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string

# ── Public base URL (pay links + M-Pesa callbacks) ──
PUBLIC_BASE_URL=https://school.edufy.finance
PAY_LINK_TTL_MIN=10

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-random-32-chars
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v20.0

# ── SMS fallback (Africa's Talking) ──
AT_USERNAME=
AT_API_KEY=

# ── Reminders ──
REMINDER_SCHEDULE=14,7,1

# ── Frontend ──
VITE_API_URL=
